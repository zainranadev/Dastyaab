NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://services:services@localhost:5432/services
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# Image storage: "local" (dev, saved in ./uploads) or "cloudinary"
STORAGE_DRIVER=local
PUBLIC_API_URL=http://localhost:3000
CLOUDINARY_URL=
PROBLEM_EXPIRY_DAYS=7
MAX_QUOTES_PER_PROBLEM=10
BOOKING_AUTO_COMPLETE_HOURS=72
# Seed (dev only)
SEED_ADMIN_EMAIL=admin@services.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_CITY=Faisalabad
